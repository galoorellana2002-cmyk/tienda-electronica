# Opcional. Sin MONGODB_URI la tienda funciona en modo demo en memoria con el seed.
# MongoDB Atlas M0 es gratis: mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/circuito-andino
MONGODB_URI=

# Obligatorio en producción si usas MONGODB_URI. Cualquier texto largo y aleatorio.
JWT_SECRET=

# Puerto de la API en desarrollo (Vite redirige /api aquí).
PORT=3011
